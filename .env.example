# HostelX Platform Environment Configuration
SECRET_KEY=django-insecure-hostelx-smart-exchange-management-platform-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=hostel_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Or provide a complete PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hostel_db

# Fallback / Offline SQLite mode (set to True to switch back to SQLite):
# USE_SQLITE=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

